{
  "_comment": "Copy to <workspace>/.agents/TEST_MANIFEST.json. One entry per test. deps = globs of every file whose change could alter the result (the code under test, its callers, fixtures, the test itself). Use `impact_and_cache.py deps-suggest --root . --symbol <fn>` to find callers.",
  "tests": [
    {
      "id": "UNIT-rule-boundaries",
      "tier": 1,
      "cmd": "./gradlew :core:test --tests '*LimitRuleBoundaryTest'",
      "deps": ["core/src/**/LimitRule*.kt", "core/src/test/**/LimitRuleBoundaryTest.kt"],
      "always": true,
      "covers": ["ORACLE-1", "ORACLE-2"]
    },
    {
      "id": "INT-caller-entry-flow",
      "tier": 2,
      "cmd": "./gradlew :app:testDebugUnitTest --tests '*EntryFlowFlowTest'",
      "deps": ["core/src/**/LimitRule*.kt", "app/src/**/EntryFlow*.kt", "app/src/test/**/EntryFlowFlowTest.kt"],
      "covers": ["ORACLE-3"]
    },
    {
      "id": "E2E-sequential-scenario",
      "tier": 3,
      "cmd": "./gradlew :app:connectedDebugAndroidTest --tests '*SequentialScenario'",
      "deps": ["core/src/**/*.kt", "app/src/**/*.kt", "app/src/androidTest/**/SequentialScenario.kt"],
      "covers": ["ORACLE-1", "ORACLE-4"]
    },
    {
      "id": "DEEP-full-replay",
      "tier": 4,
      "cmd": "./gradlew connectedCheck",
      "deps": ["**/*.kt"],
      "covers": ["release-gate"]
    }
  ]
}
