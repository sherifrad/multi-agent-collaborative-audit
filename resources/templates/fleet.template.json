{
  "$schema": "https://raw.githubusercontent.com/sherifrad/multi-agent-collaborative-audit/main/schemas/fleet.v1.json",
  "version": "1.0.0",
  "description": "MACA Dynamic Fleet Manifest. Configures how each engineering lane is executed across CLIs, direct APIs, local LLMs, or In-IDE subagents.",
  "strategy": {
    "default_mode": "auto",
    "cascade_on_failure": true,
    "fallback_order": [
      "configured_lane",
      "detected_local_cli",
      "ide_subagent",
      "single_model_tabula_rasa"
    ]
  },
  "lanes": {
    "ui_ux": {
      "role": "UI/UX & Graphic Mocking Lane",
      "primary": {
        "adapter": "cli",
        "binary": "claude",
        "model": "claude-3-7-sonnet",
        "args": ["-p", "{brief}", "--permission-mode", "{permission_mode}"]
      },
      "fallback": {
        "adapter": "subagent",
        "role_name": "UI/UX Designer",
        "instructions": "Generate self-contained interactive HTML/SVG prototype in .agents/mocks/"
      }
    },
    "core_logic": {
      "role": "Core Logic & Algorithms Lane",
      "primary": {
        "adapter": "cli",
        "binary": "opencode",
        "model": "deepseek-ai/deepseek-r1",
        "args": ["run", "-m", "{model}", "{brief}"]
      },
      "fallback": {
        "adapter": "subagent",
        "role_name": "Core Logic Engineer",
        "instructions": "Implement domain logic adhering to Ponytail Rungs 1-3"
      }
    },
    "data": {
      "role": "Data & Serialization Lane",
      "primary": {
        "adapter": "cli",
        "binary": "codex",
        "args": ["exec", "--brief", "{brief}"]
      },
      "fallback": {
        "adapter": "subagent",
        "role_name": "Data Architect",
        "instructions": "Validate schemas, boundary DTOs, and migrations"
      }
    },
    "qa_referee": {
      "role": "QA & Procedural Referee Lane",
      "primary": {
        "adapter": "cli",
        "binary": "gemini",
        "args": ["-p", "{brief}"]
      },
      "fallback": {
        "adapter": "subagent",
        "role_name": "QA Referee",
        "instructions": "Conduct Rule 6 Tabula Rasa adversarial diff critique and sequential E2E oracle"
      }
    }
  },
  "custom_providers_examples": {
    "direct_api_openai_compatible": {
      "adapter": "api",
      "protocol": "openai-compatible",
      "endpoint": "https://api.deepseek.com/v1/chat/completions",
      "api_key_env": "DEEPSEEK_API_KEY",
      "model": "deepseek-chat",
      "timeout_seconds": 30
    },
    "free_local_ollama": {
      "adapter": "api",
      "protocol": "openai-compatible",
      "endpoint": "http://127.0.0.1:11434/v1/chat/completions",
      "api_key_env": "OLLAMA_API_KEY_OPTIONAL",
      "model": "qwen2.5-coder:latest",
      "timeout_seconds": 60
    },
    "custom_agent_script": {
      "adapter": "script",
      "executable": "./scripts/my_agent_runner.sh",
      "args": ["--task", "{brief}"]
    },
    "zero_api_subagent_only": {
      "adapter": "subagent",
      "role_name": "Autonomous In-IDE Agent",
      "notes": "100% free, zero external keys, works directly in Antigravity"
    }
  }
}
